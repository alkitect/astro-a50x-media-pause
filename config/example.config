# Copy to ~/.config/astro-a50x-spotify-pause/config (seeded by install-to-local.sh).
# Run discover-a50x-sink.sh, then set SINK_MATCH and PLAYER before ENABLED=1.

# Must be 1 before real pause/play (safety gate).
ENABLED=0

# 1 = log would-pause / would-play only (no playerctl pause/play).
DRY_RUN=1

# Regex matched against `pactl list short sinks` lines. Replace via discover.
SINK_MATCH=REPLACE_ME_FROM_DISCOVER

# MPRIS player name from `playerctl -l` (often "spotify" for the snap).
# Required when PLAYER_MODE=single; optional when PLAYER_MODE=all.
PLAYER=REPLACE_ME_FROM_DISCOVER

# single = only PLAYER; all = every Playing MPRIS player from playerctl -l.
# Keep single until F4-multi PASS; then set all after DRY_RUN soak.
PLAYER_MODE=single

# Trailing debounce after last relevant pactl sink event (milliseconds).
DEBOUNCE_MS=200

# Wait after sink returns before playerctl play (milliseconds).
RESUME_DELAY_MS=400

# 1 = only pause when playerctl status is Playing (per eligible player).
REQUIRE_PLAYING=1

# 1 = on sink return, play only if this watcher paused media (we_paused_players).
AUTO_RESUME=1

# 1 = clear we_paused if user takes control while sink is gone (Playing) or player Stops/exits.
CLEAR_ON_USER_PAUSE=1

# 1 = log every debounced edge evaluation (noisy). Actions always logged.
LOG_EDGE_EVENTS=0

# Poll every N seconds (off-match edge + latch + optional HID).
POLL_SEC=1

# After sink-input remove / HID while on A50, keep disable-intent latch this many seconds
# (>= soft-disable PipeWire tail ~12s).
DISABLE_LATCH_SEC=15

# HID: Gen5 battery GET dock_chg (F2b/F3) + passive soft-off/on prefixes (F2e/F3b/F3c).
# Keep 0 until F4b human matrix PASS (dock already PASS; re-gate after soft-off wire).
# Requires rw hidraw + xxd (udev rule).
HID_ENABLE=0
# Deprecated: old passive substring. Leave empty (watcher ignores).
HID_MATCH_HEX=
# Optional override e.g. /dev/hidraw10 (empty = auto-discover 046d:0b0b).
HID_DEVICE=
# Soft-disable pause prefix (F2e PASS). Empty = default 020c04000a0006.
HID_SOFT_OFF_PREFIX=
# Power-on resume prefix (F2e ON). Empty = default 020c0400130000. Never use cmd=06 (GET replies).
HID_SOFT_ON_PREFIX=
